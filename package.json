{
  "name": "fuego-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:push": "pnpm -C apps/backend run db:push",
    "test:api": "node scripts/test-phase0.mjs",
    "test:phase1": "node scripts/test-phase1.mjs",
    "postinstall": "node scripts/check-deps.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@swc/core",
      "esbuild",
      "electron"
    ]
  }
}
