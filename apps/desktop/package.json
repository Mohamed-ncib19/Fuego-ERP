{
  "name": "@fuego/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && electron .",
    "start": "electron .",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "bundle": "node ../../scripts/bundle-app.mjs",
    "dist:dir": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@fuego/backend": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "description": "Fuego — gestion des commandes, revenus et dépenses",
  "author": "Fuego"
}
